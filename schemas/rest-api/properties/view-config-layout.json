{
	"$schema": "https://json-schema.org/draft/2019-09/hyper-schema",
	"$id": "https://raw.githubusercontent.com/johnbillion/wp-json-schemas/trunk/schemas/rest-api/properties/view-config-layout.json",
	"title": "WP_REST_API_View_Config_Layout",
	"description": "A layout configuration which accepts the properties of every view type, for use where the view type isn't known ahead of time.",
	"type": "object",
	"properties": {
		"styles": {
			"description": "The styles applied to each column, keyed by field.",
			"type": "object",
			"additionalProperties": {
				"$ref": "./view-config-column-style.json"
			}
		},
		"density": {
			"type": "string",
			"enum": [
				"compact",
				"balanced",
				"comfortable"
			]
		},
		"enableMoving": {
			"type": "boolean"
		},
		"badgeFields": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"previewSize": {
			"type": "number"
		}
	},
	"additionalProperties": false
}
