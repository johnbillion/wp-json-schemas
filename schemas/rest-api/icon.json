{
	"$schema": "https://json-schema.org/draft/2019-09/hyper-schema",
	"$id": "https://raw.githubusercontent.com/johnbillion/wp-json-schemas/trunk/schemas/rest-api/icon.json",
	"title": "WP_REST_API_Icon",
	"description": "An icon object in a REST API context.",
	"readOnly": true,
	"type": "object",
	"required": [
		"name",
		"label",
		"content",
		"collection"
	],
	"properties": {
		"name": {
			"description": "The icon name.",
			"type": "string",
			"readOnly": true
		},
		"label": {
			"description": "The icon label.",
			"type": "string",
			"readOnly": true
		},
		"content": {
			"description": "The icon content (SVG markup).",
			"type": "string",
			"readOnly": true
		},
		"collection": {
			"description": "The slug of the collection this icon belongs to.",
			"type": "string",
			"readOnly": true
		}
	},
	"links": [
		{
			"rel": "self",
			"href": "/wp/v2/icons/{name}",
			"hrefSchema": {
				"properties": {
					"name": {
						"$ref": "#/properties/name"
					}
				}
			},
			"targetSchema": {
				"$ref": "#"
			}
		},
		{
			"rel": "collection",
			"href": "/wp/v2/icons",
			"targetSchema": {
				"type": "array",
				"items": {
					"$ref": "#"
				}
			}
		}
	]
}
